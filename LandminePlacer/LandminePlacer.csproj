<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <Description>A Lethal Company mod that add a new item for placing mine</Description>
        <Version>1.0.4</Version>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <Product>Landmine Placer</Product>
        <Authors>alexandre v1</Authors>
    </PropertyGroup>

    <ItemGroup>
		<PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
		<PackageReference Include="BepInEx.BaseLib" Version="5.4.20" />
		<PackageReference Include="BepInEx.Core" Version="5.*" />
		<PackageReference Include="Evaisa.LethalLib" Version="1.2.0" />
        <PackageReference Include="UnityEngine.Modules" Version="2022.3.9" IncludeAssets="compile" />
		<PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.1" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
    </ItemGroup>

	<Target Name="NetcodePatch" AfterTargets="PostBuildEvent">
		<Exec Command="netcode-patch -uv 2022.3.62 -nv 1.12.2 -tv 1.0.0 &quot;$(TargetPath)&quot; @(ReferencePathWithRefAssemblies->'&quot;%(Identity)&quot;', ' ')"/>
	</Target>

	<!-- ===== Thunderstore Pack Target ===== -->
	<!--
		Usage: dotnet build -t:ThunderstorePack
		Output: $(SolutionDir)dist\LandminePlacer-<version>.zip
	-->
	<Target Name="ThunderstorePack" AfterTargets="NetcodePatch">

		<!-- Staging directory -->
		<PropertyGroup>
			<ThunderstoreStaging>$(MSBuildProjectDirectory)\..\dist\_staging</ThunderstoreStaging>
			<ThunderstoreDist>$(MSBuildProjectDirectory)\..\dist</ThunderstoreDist>
			<ThunderstoreSource>$(MSBuildProjectDirectory)\..\Thunderstore</ThunderstoreSource>
			<ZipName>LandminePlacer-$(Version).zip</ZipName>
		</PropertyGroup>

		<!-- Clean staging -->
		<RemoveDir Directories="$(ThunderstoreStaging)" />
		<MakeDir Directories="$(ThunderstoreStaging)" />

		<!-- Copy metadata files -->
		<Copy SourceFiles="$(ThunderstoreSource)\manifest.json" DestinationFolder="$(ThunderstoreStaging)" />
		<Copy SourceFiles="$(ThunderstoreSource)\icon.png"      DestinationFolder="$(ThunderstoreStaging)" />
		<Copy SourceFiles="$(MSBuildProjectDirectory)\..\README.md" DestinationFolder="$(ThunderstoreStaging)" />
		<Copy SourceFiles="$(ThunderstoreSource)\CHANGELOG.md"  DestinationFolder="$(ThunderstoreStaging)" />

		<!-- Copy DLL -->
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ThunderstoreStaging)" />

		<!-- Copy any extra assets (if present) -->
		<ItemGroup>
			<ThunderstoreAssets Include="$(ThunderstoreSource)\landmine_placer\**\*" />
		</ItemGroup>
		<Copy SourceFiles="@(ThunderstoreAssets)"
			  DestinationFiles="@(ThunderstoreAssets->'$(ThunderstoreStaging)\%(RecursiveDir)%(Filename)%(Extension)')" />

		<!-- Zip the staging folder -->
		<MakeDir Directories="$(ThunderstoreDist)" />
		<Delete Files="$(ThunderstoreDist)\$(ZipName)" />
		<Exec Command="powershell -NoProfile -Command &quot;Compress-Archive -Path '$(ThunderstoreStaging)\*' -DestinationPath '$(ThunderstoreDist)\$(ZipName)' -Force&quot;" />

		<!-- Clean up staging -->
		<RemoveDir Directories="$(ThunderstoreStaging)" />

		<Message Text="================================================" Importance="High" />
		<Message Text="Thunderstore package ready: dist\$(ZipName)" Importance="High" />
		<Message Text="================================================" Importance="High" />
	</Target>
	
    <ItemGroup>
      <Reference Include="Assembly-CSharp" Publicize="true">
        <HintPath>lib\Assembly-CSharp.dll</HintPath>
      </Reference>
      <Reference Include="Unity.InputSystem">
        <HintPath>lib\Unity.InputSystem.dll</HintPath>
      </Reference>
      <Reference Include="Unity.Netcode.Runtime">
        <HintPath>lib\Unity.Netcode.Runtime.dll</HintPath>
      </Reference>
      <Reference Include="UnityEngine">
        <HintPath>lib\UnityEngine.dll</HintPath>
      </Reference>
    </ItemGroup>
</Project>
